{
  "schema": "gamecult.eve.plugin_advertisement.v1",
  "pluginId": "sai.vn",
  "ownerService": "sai",
  "version": "0.1.0",
  "manifestAddress": "file://plugins/sai-vn.plugin.json",
  "runtime": {
    "invocationModel": "executable-sidecar",
    "contract": "gamecult.eve.plugin_abi.v1",
    "transports": ["cultnet-rudp", "stdio"],
    "authority": ["renderer-independent", "no-provider-state-mutation", "provider-accepts-or-denies-commands"],
    "sidecar": {
      "processKind": "long-running-daemon",
      "protocol": "cultnet-operation-v0",
      "debugProtocol": "stdio-ndjson",
      "requestSchema": "gamecult.eve.plugin_abi.request.v1",
      "responseSchema": "gamecult.eve.plugin_abi.response.v1",
      "operations": ["describe", "validate", "open", "apply", "project", "jump"],
      "commandEnvelope": "gamecult.eve.command_invocation.v1",
      "receiptSchema": "gamecult.eve.command_receipt.v1",
      "launch": { "command": "node", "artifact": "src/eve-cultnet-sidecar.cjs" },
      "stateAuthority": "sai-sidecar-owns-story-session-provider-owns-command-acceptance"
    }
  },
  "schemas": ["sai.vn.story_session.v1", "sai.vn.visual_manifest.v1"],
  "componentKinds": ["vn.stage", "panel.dialogue", "text.dialogue", "rail.actions"],
  "commands": ["story.continue", "story.choose", "story.jump"],
  "fixtures": ["sai-vn"]
}
